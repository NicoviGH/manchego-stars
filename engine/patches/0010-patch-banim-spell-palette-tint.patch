 #include "ekrdragon.h"
 
+static u8 GetBanimSpellPaletteTint(struct Anim *anim)
+{
+    struct BattleUnit *bu;
+    const struct BanimSpellPaletteTint *it;
+
+    if (GetAnimPosition(anim) == EKR_POS_L)
+        bu = gpEkrBattleUnitLeft;
+    else
+        bu = gpEkrBattleUnitRight;
+
+    for (it = gBanimSpellPaletteTints; it->character != 0; it++) {
+        if (it->character == bu->unit.pCharacterData->number
+            && it->weapon_type == GetItemType(bu->weaponBefore))
+            return it->tint;
+    }
+
+    return BANIM_SPELL_TINT_NONE;
+}
