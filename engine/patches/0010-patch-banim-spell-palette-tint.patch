+static u16 BanimSpellTintGreen(u16 color)
+{
+    int r = color & 0x1F;
+    int g = (color >> 5) & 0x1F;
+    int b = (color >> 10) & 0x1F;
+    int high = r;
+    int low = r;
+
+    if (g > high) high = g;
+    if (b > high) high = b;
+    if (g < low) low = g;
+    if (b < low) low = b;
+    if (high - low < 3)
+        return color;
+
+    return (low + (high - low) / 4)
+        | (high << 5)
+        | ((low + (high - low) / 6) << 10);
+}
+
+static u16 BanimSpellTintBlue(u16 color)
+{
+    int r = color & 0x1F;
+    int g = (color >> 5) & 0x1F;
+    int b = (color >> 10) & 0x1F;
+    int high = r;
+    int low = r;
+
+    if (g > high) high = g;
+    if (b > high) high = b;
+    if (g < low) low = g;
+    if (b < low) low = b;
+    if (high - low < 3)
+        return color;
+
+    return (low + (high - low) / 6)
+        | ((low + (high - low) / 2) << 5)
+        | (high << 10);
+}
+
+static u16 BanimSpellTintCyan(u16 color)
+{
+    int r = color & 0x1F;
+    int g = (color >> 5) & 0x1F;
+    int b = (color >> 10) & 0x1F;
+    int high = r;
+    int low = r;
+
+    if (g > high) high = g;
+    if (b > high) high = b;
+    if (g < low) low = g;
+    if (b < low) low = b;
+    if (high - low < 3)
+        return color;
+
+    return (low + (high - low) / 6)
+        | (high << 5)
+        | (high << 10);
+}
+
+static u16 BanimSpellTintGold(u16 color)
+{
+    int r = color & 0x1F;
+    int g = (color >> 5) & 0x1F;
+    int b = (color >> 10) & 0x1F;
+    int high = r;
+    int low = r;
+
+    if (g > high) high = g;
+    if (b > high) high = b;
+    if (g < low) low = g;
+    if (b < low) low = b;
+    if (high - low < 3)
+        return color;
+
+    return high
+        | ((low + (high - low) * 3 / 4) << 5)
+        | ((low + (high - low) / 6) << 10);
+}
+
+static void BanimSpellPaletteCopy(const u16 *src, u16 *dst, u32 size)
+{
+    u32 i;
+
+    if (gMSSpellTint == BANIM_SPELL_TINT_NONE) {
+        CpuFastCopy(src, dst, size);
+        return;
+    }
+
+    for (i = 0; i < size / sizeof(u16); i++) {
+        if (gMSSpellTint == BANIM_SPELL_TINT_BLUE)
+            dst[i] = BanimSpellTintBlue(src[i]);
+        else if (gMSSpellTint == BANIM_SPELL_TINT_CYAN)
+            dst[i] = BanimSpellTintCyan(src[i]);
+        else if (gMSSpellTint == BANIM_SPELL_TINT_GOLD)
+            dst[i] = BanimSpellTintGold(src[i]);
+        else
+            dst[i] = BanimSpellTintGreen(src[i]);
+    }
+}
+
 void SpellFx_RegisterObjGfx(const u16 * img, u32 size)
 {
     u16 * dst = OBJ_VRAM0 + VRAMOFF_BANIM_SPELL_OBJ;
