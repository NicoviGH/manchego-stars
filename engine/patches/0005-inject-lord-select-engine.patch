+/* Lord select (campaign engine, #42): resolve the player-chosen lead.
+   gLordSelectCandidates (events_udefs.c, build-generated) lists the cast
+   pids in menu order; the ch01 menu records the pick as permanent flag
+   0xF0 + index (saved with the file; zeroed on New Game by
+   ResetPermanentFlags). Fallback while nothing is set (debug entry
+   before the menu has run): the first candidate. */
+u16 LordSelect_GetPid(void)
+{
+    extern const u16 gLordSelectCandidates[];
+    int i;
+
+    for (i = 0; gLordSelectCandidates[i] != 0xFFFF; i++) {
+        if (CheckFlag(0xF0 + i)) {
+            return gLordSelectCandidates[i];
+        }
+    }
+
+    return gLordSelectCandidates[0];
+}
+
